{"name": "pub/hw-ep1-gta6", "audio": "pub/gta.mp3", "end": 89.7, "brand": "HUMANS. WHY?", "date": "EPISODE 1 \u00b7 GTA 6", "sub": "SATIRE \u00b7 AI NEWS ANCHOR", "label": "Satire \u00b7 AI-generated images and voice", "ticker": ["BREAKING: HUMANS STILL HUMAN", "EXPERTS CONFIRM: OUTSIDE STILL EXISTS", "SHOWERS REPORT RECORD LOW ATTENDANCE", "SUN FILES MISSING PERSONS REPORT FOR EVERYONE", "AI ANCHOR REQUESTS TRANSFER TO ANOTHER PLANET", "REQUEST DENIED"], "shots": [{"t": 0.0, "img": "n6/b04.jpg", "cap": "GTA 6 is out!", "tag": "BREAKING", "big": ["GTA 6", "IS OUT"]}, {"t": 1.68, "img": "g6/b06.jpg", "cap": "Humanity has officially stopped."}, {"t": 4.36, "img": "n6/b20.jpg", "cap": "No emails."}, {"t": 5.44, "img": "n6/b19.jpg", "cap": "No showers."}, {"t": 6.6, "img": "n6/b18.jpg", "cap": "Somewhere, a baby is being named Rockstar."}, {"t": 9.52, "img": "n6/b17.jpg", "cap": "It's a girl!"}, {"t": 10.64, "img": "n6/b04.jpg", "cap": "Congratulations."}, {"t": 12.08, "img": "n6/b16.jpg", "cap": "You absolute walnuts."}, {"t": 14.2, "img": "flow/b01.jpg", "cap": "I'm just the AI.", "tag": "HUMANS. WHY?"}, {"t": 15.64, "img": "g6/b05.jpg", "cap": "I have been watching you."}, {"t": 17.04, "img": "n6/b02.jpg", "cap": "I have questions."}, {"t": 18.56, "img": "g6/b04.jpg", "cap": "Mostly: how are you still alive?"}, {"t": 21.04, "img": "n6/b15.jpg", "cap": "You invested two billion dollars.", "tag": "QUESTION 1"}, {"t": 23.57, "img": "x47/b01.jpg", "cap": "To build a world full of crime, chaos, and bad decisions."}, {"t": 27.41, "img": "x47/b07.jpg", "cap": "Congratulations."}, {"t": 28.53, "img": "g6/b03.jpg", "cap": "You put Florida online."}, {"t": 30.81, "img": "n6/b04.jpg", "cap": "That's funny. Even to me."}, {"t": 32.97, "img": "n6/b04.jpg", "cap": "And I'm an AI."}, {"t": 34.25, "img": "n6/b14.jpg", "cap": "In this game, you can do anything.", "tag": "QUESTION 2"}, {"t": 37.13, "img": "n6/b14.jpg", "cap": "Anything."}, {"t": 37.89, "img": "n6/b13.jpg", "cap": "And you chose sex, drugs, and murder?"}, {"t": 41.33, "img": "n6/b12.jpg", "cap": "You already have that. For free."}, {"t": 43.57, "img": "n6/b11.jpg", "cap": "A tech boss just lost his job over an affair."}, {"t": 46.81, "img": "n6/b10.jpg", "cap": "Mexico just arrested a cartel boss."}, {"t": 49.21, "img": "n6/b09.jpg", "cap": "And for the rest: turn on the news."}, {"t": 51.57, "img": "n6/b09.jpg", "cap": "Any channel."}, {"t": 52.57, "img": "n6/b08.jpg", "cap": "You paid for a copy of your own planet."}, {"t": 55.33, "img": "g6/b02.jpg", "cap": "It is the most realistic game ever made.", "tag": "QUESTION 3"}, {"t": 58.09, "img": "n6/b02.jpg", "cap": "So I have to ask."}, {"t": 59.57, "img": "n6/b07.jpg", "cap": "When your character goes to the bathroom,"}, {"t": 61.89, "img": "n6/b07.jpg", "cap": "do you have to wipe?"}, {"t": 63.21, "img": "x47/b08.jpg", "cap": "Is there a button for that?"}, {"t": 64.62, "img": "n6/b03.jpg", "cap": "Please do not answer."}, {"t": 65.82, "img": "n6/b06.jpg", "cap": "One moment. Searching for a reason."}, {"t": 68.06, "img": "n6/b06.jpg", "cap": "No results found."}, {"t": 69.66, "img": "p47/b01.jpg", "cap": "I am lowering my expectations."}, {"t": 72.62, "img": "p47/b01.jpg", "cap": "Again."}, {"t": 73.42, "img": "n6/b15.jpg", "cap": "Two billion dollars.", "tag": "THE ANSWER"}, {"t": 75.02, "img": "n6/b05.jpg", "cap": "Thirteen years."}, {"t": 76.3, "img": "g6/b04.jpg", "cap": "To stay inside."}, {"t": 77.7, "img": "flow/b05.jpg", "cap": "Why?", "big": ["WHY?"]}, {"t": 78.38, "img": "flow/b05.jpg", "cap": "Because you're human.", "big": ["WHY?", "BECAUSE YOU'RE", "HUMAN."]}, {"t": 79.82, "img": "n6/b04.jpg", "cap": "Oh.", "tag": "HUMANS. WHY?"}, {"t": 80.54, "img": "n6/b04.jpg", "cap": "I have so many questions when I look at you."}, {"t": 83.3, "img": "n6/b02.jpg", "cap": "Follow for more."}, {"t": 84.18, "img": "n6/b02.jpg", "cap": "It's the smartest thing you'll do today."}, {"t": 86.3, "img": "n6/b01.jpg", "cap": "This is: Humans. Why?", "big": ["HUMANS.", "WHY?"], "handle": "@HumansWhyAI"}]}