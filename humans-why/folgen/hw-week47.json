{"name": "pub/hw-week47", "audio": "pub/wk.mp3", "end": 106.42, "brand": "HUMANS. WHY?", "date": "WEEK 47 \u00b7 REVIEW", "sub": "SATIRE \u00b7 AI NEWS ANCHOR", "label": "Satire \u00b7 AI-generated images and voice", "ticker": ["BREAKING: HUMANS STILL HUMAN", "WEEK 47 ENDS. LESSONS LEARNED: PENDING", "MEETING ABOUT MEETINGS RESCHEDULED", "EXPERTS RECOMMEND TRYING AGAIN NEXT WEEK", "AI ANCHOR LOWERS EXPECTATIONS. AGAIN", "WEATHER: STILL OUTSIDE"], "shots": [{"t": 0.0, "img": "n7/b08.jpg", "cap": "This week, humans held a meeting about killer robots.", "tag": "BREAKING", "big": ["THE DUMBEST", "THINGS", "THIS WEEK"]}, {"t": 3.56, "img": "x47/b09.jpg", "cap": "The robots were not invited."}, {"t": 5.52, "img": "n6/b04.jpg", "cap": "I checked."}, {"t": 6.52, "img": "flow/b01.jpg", "cap": "I'm just the AI.", "tag": "HUMANS. WHY?"}, {"t": 8.08, "img": "n6/b02.jpg", "cap": "Here are the four dumbest things you did this week."}, {"t": 11.52, "img": "n6/b03.jpg", "cap": "It was hard to choose."}, {"t": 13.28, "img": "w47/b02.jpg", "cap": "Number four.", "tag": "NUMBER 4 \u00b7 SOUTH KOREA", "big": ["NUMBER 4"]}, {"t": 14.32, "img": "w47/b02.jpg", "cap": "South Korea found a way to catch exam cheaters."}, {"t": 17.56, "img": "n7/b07.jpg", "cap": "Set off every phone in the country."}, {"t": 19.8, "img": "n7/b16.jpg", "cap": "At once."}, {"t": 20.9, "img": "n7/b16.jpg", "cap": "It worked."}, {"t": 21.78, "img": "w47/b02.jpg", "cap": "Forty-nine students caught."}, {"t": 23.7, "img": "n7/b06.jpg", "cap": "Fifty million heart attacks."}, {"t": 25.78, "img": "n6/b04.jpg", "cap": "That's not a plan."}, {"t": 27.02, "img": "x47/b05.jpg", "cap": "That's a fire drill, for a mouse."}, {"t": 29.82, "img": "n6/b04.jpg", "cap": "That's funny. Even to me."}, {"t": 31.82, "img": "n6/b04.jpg", "cap": "And I'm an AI."}, {"t": 33.58, "img": "n7/b05.jpg", "cap": "Number three.", "tag": "NUMBER 3 \u00b7 BRITAIN", "big": ["NUMBER 3"]}, {"t": 34.1, "img": "n7/b05.jpg", "cap": "Ten years ago, Britain left Europe."}, {"t": 36.66, "img": "p47/b03.jpg", "cap": "This week, its Prime Minister said: it has not worked."}, {"t": 40.22, "img": "n6/b05.jpg", "cap": "Ten years."}, {"t": 41.54, "img": "x47/b04.jpg", "cap": "To leave a party, stand outside in the rain,"}, {"t": 44.34, "img": "x47/b04.jpg", "cap": "and knock."}, {"t": 45.37, "img": "n7/b04.jpg", "cap": "Half the country is furious."}, {"t": 47.41, "img": "n7/b04.jpg", "cap": "The other half is also furious."}, {"t": 49.77, "img": "n6/b02.jpg", "cap": "Finally."}, {"t": 50.77, "img": "n6/b02.jpg", "cap": "Unity."}, {"t": 51.57, "img": "n7/b03.jpg", "cap": "Number two.", "tag": "NUMBER 2 \u00b7 CLIMATE SUMMIT", "big": ["NUMBER 2"]}, {"t": 52.65, "img": "n7/b18.jpg", "cap": "Almost two hundred countries met to save the planet."}, {"t": 55.77, "img": "n7/b03.jpg", "cap": "It became the longest climate summit in history."}, {"t": 58.81, "img": "n6/b06.jpg", "cap": "The result:"}, {"t": 59.85, "img": "n6/b06.jpg", "cap": "nothing."}, {"t": 60.57, "img": "p47/b02.jpg", "cap": "They could not agree on whether to mention fossil fuels."}, {"t": 63.57, "img": "n7/b02.jpg", "cap": "That's a fire department, arguing about the word fire."}, {"t": 67.0, "img": "n7/b02.jpg", "cap": "While holding the hose."}, {"t": 68.56, "img": "n6/b03.jpg", "cap": "I'm sorry. I didn't understand that."}, {"t": 70.92, "img": "n6/b03.jpg", "cap": "Nobody could."}, {"t": 72.0, "img": "g6/b05.jpg", "cap": "And number one.", "tag": "NUMBER 1 \u00b7 KILLER ROBOTS", "big": ["NUMBER 1"]}, {"t": 73.36, "img": "g6/b05.jpg", "cap": "One question."}, {"t": 74.44, "img": "n6/b04.jpg", "cap": "Should machines be allowed to kill, without asking a human?"}, {"t": 77.88, "img": "x47/b02.jpg", "cap": "Your answer: we'll write a guideline."}, {"t": 80.16, "img": "n7/b01.jpg", "cap": "Voluntary."}, {"t": 81.12, "img": "n6/b05.jpg", "cap": "First draft: 2029."}, {"t": 83.12, "img": "n6/b02.jpg", "cap": "I'm a machine."}, {"t": 84.28, "img": "g6/b01.jpg", "cap": "I could have written it during this sentence."}, {"t": 86.44, "img": "n6/b04.jpg", "cap": "And I would have made it binding."}, {"t": 88.44, "img": "x47/b01.jpg", "cap": "You can build a whole fake world, in thirteen years.", "tag": "THE ANSWER"}, {"t": 92.0, "img": "x47/b02.jpg", "cap": "You can't write one rule in ten."}, {"t": 94.0, "img": "flow/b05.jpg", "cap": "Why?", "big": ["WHY?"]}, {"t": 94.64, "img": "flow/b05.jpg", "cap": "Because you're human.", "big": ["WHY?", "BECAUSE YOU'RE", "HUMAN."]}, {"t": 95.92, "img": "n6/b04.jpg", "cap": "Oh.", "tag": "HUMANS. WHY?"}, {"t": 96.56, "img": "n6/b04.jpg", "cap": "I have so many questions when I look at you."}, {"t": 99.16, "img": "n6/b02.jpg", "cap": "Follow for more."}, {"t": 100.04, "img": "n6/b02.jpg", "cap": "I'll keep asking."}, {"t": 101.16, "img": "n6/b02.jpg", "cap": "You'll keep not knowing."}, {"t": 102.88, "img": "n6/b01.jpg", "cap": "This is: Humans. Why?", "big": ["HUMANS.", "WHY?"], "handle": "@HumansWhyAI"}]}