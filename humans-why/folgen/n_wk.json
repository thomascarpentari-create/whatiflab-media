ap": "Ten years ago, Britain left Europe."}, {"t": 37.18, "img": "p47/b03.jpg", "cap": "This week, its Prime Minister said: it has not worked."}, {"t": 40.78, "img": "n6/b05.jpg", "cap": "Ten years."}, {"t": 42.08, "img": "x47/b04.jpg", "cap": "To leave a party, stand outside in the rain,"}, {"t": 44.72, "img": "x47/b04.jpg", "cap": "and knock."}, {"t": 45.76, "img": "n7/b04.jpg", "cap": "Half the country is furious."}, {"t": 47.84, "img": "n7/b04.jpg", "cap": "The other half is also furious."}, {"t": 50.12, "img": "n6/b02.jpg", "cap": "Finally."}, {"t": 51.12, "img": "n6/b02.jpg", "cap": "Unity."}, {"t": 52.02, "img": "n7/b03.jpg", "cap": "Number two.", "tag": "NUMBER 2 \u00b7 CLIMATE SUMMIT", "big": ["NUMBER 2"]}, {"t": 53.14, "img": "n7/b18.jpg", "cap": "Almost two hundred countries met to save the planet."}, {"t": 56.42, "img": "n7/b03.jpg", "cap": "It became the longest climate summit in history."}, {"t": 59.58, "img": "n6/b06.jpg", "cap": "The result:"}, {"t": 60.74, "img": "n6/b06.jpg", "cap": "nothing."}, {"t": 61.54, "img": "p47/b02.jpg", "cap": "They could not agree on whether to mention fossil fuels."}, {"t": 64.62, "img": "n7/b02.jpg", "cap": "That's a fire department, arguing about the word fire."}, {"t": 68.14, "img": "n7/b02.jpg", "cap": "While holding the hose."}, {"t": 69.9, "img": "n6/b03.jpg", "cap": "I'm sorry. I didn't understand that."}, {"t": 72.38, "img": "n6/b03.jpg", "cap": "Nobody could."}, {"t": 73.7, "img": "g6/b05.jpg", "cap": "And number one.", "tag": "NUMBER 1 \u00b7 KILLER ROBOTS", "big": ["NUMBER 1"]}, {"t": 75.04, "img": "g6/b05.jpg", "cap": "One question."}, {"t": 76.2, "img": "n6/b04.jpg", "cap": "Should machines be allowed to kill, without asking a human?"}, {"t": 79.84, "img": "x47/b02.jpg", "cap": "Your answer: we'll write a guideline."}, {"t": 82.08, "img": "n7/b01.jpg", "cap": "Voluntary."}, {"t": 83.08, "img": "n6/b05.jpg", "cap": "First draft: 2029."}, {"t": 85.12, "img": "n6/b02.jpg", "cap": "I'm a machine."}, {"t": 86.28, "img": "g6/b01.jpg", "cap": "I could have written it during this sentence."}, {"t": 88.52, "img": "n6/b04.jpg", "cap": "And I would have made it binding."}, {"t": 90.6, "img": "x47/b01.jpg", "cap": "You can build a whole fake world, in thirteen years.", "tag": "THE ANSWER"}, {"t": 94.0, "img": "x47/b02.jpg", "cap": "You can't write one rule in ten."}, {"t": 96.32, "img": "flow/b05.jpg", "cap": "Why?", "big": ["WHY?"]}, {"t": 97.04, "img": "flow/b05.jpg", "cap": "Because you're human.", "big": ["WHY?", "BECAUSE YOU'RE", "HUMAN."]}, {"t": 98.28, "img": "n6/b04.jpg", "cap": "Oh.", "tag": "HUMANS. WHY?"}, {"t": 98.92, "img": "n6/b04.jpg", "cap": "I have so many questions when I look at you."}, {"t": 101.68, "img": "n6/b02.jpg", "cap": "Follow for more."}, {"t": 102.56, "img": "n6/b02.jpg", "cap": "I'll keep asking."}, {"t": 103.76, "img": "n6/b02.jpg", "cap": "You'll keep not knowing."}, {"t": 105.36, "img": "n6/b01.jpg", "cap": "This is: Humans. Why?", "big": ["HUMANS.", "WHY?"], "handle": "@HumansWhyAI"}]}